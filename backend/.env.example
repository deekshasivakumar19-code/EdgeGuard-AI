FLASK_SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-another-long-random-secret
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DATABASE=edgeguard_ai
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
FLASK_DEBUG=true

# Optional SMTP configuration. Without SMTP, password reset links are
# returned only while FLASK_DEBUG=true.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
PUBLIC_APP_URL=http://localhost:5173
